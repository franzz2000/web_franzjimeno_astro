---
import { SITE_METADATA } from "@/consts";
import Link from "./Link.astro";
---

<footer class="mt-16 pb-8 text-center text-sm text-gray-500 dark:text-gray-400">
  <p>
    © {new Date().getFullYear()} ·
    <Link href="/">{SITE_METADATA.title}</Link>
  </p>
  <p class="mt-2">
    <Link href={SITE_METADATA.siteRepo} class="hover:text-primary-500">
      Código fuente en GitHub
    </Link>
  </p>
</footer>
