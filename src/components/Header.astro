---
import { NAVIGATION } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import MobileNav from "@/solid/MobileNav.tsx";
import ThemeSwitcher from "@/solid/ThemeSwitcher.tsx";
import { useTranslations, getLangFromUrl } from "@/i18n"; // Añadimos getLangFromUrl
import cabecera from "@/assets/cabecera.jpg"
import Cabecera_url from "@/assets/cabecera.jpg?url"
import { getImage } from "astro:assets";

const lang = getLangFromUrl(Astro.url); // Detectamos el idioma
const t = useTranslations(lang);        // Pasamos el idioma a las traducciones de Astro

const optimizedBackground = await getImage({src: cabecera, format: 'webp'})
---

<header 
    class="flex items-center justify-between py-10 px-4 shadow-lg bg-cover bg-center min-h-[250px]"
    style={`background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(${Cabecera_url})`}>
  
  <div class="mr-3 md:w-40 w-20">
    <a href="/" aria-label={t("siteMetadata.headerTitle")}>
      <Logo class="w-full" />
    </a>
  </div>

  <div class="flex items-center gap-4">
    <div class="hidden sm:flex items-center space-x-6 mr-4">
      {NAVIGATION.filter((link) => link.href !== "/").map((link) => (
        <HeaderLink
          href={link.href}
          class="font-medium text-white hover:text-gray-300 transition-colors drop-shadow-md"
        >
          {t(link.title)}
        </HeaderLink>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <div class="text-white">
        <ThemeSwitcher client:only="solid-js" />
      </div>
      
      <div class="sm:hidden flex items-center">
        <!-- LE PASAMOS EL IDIOMA AL COMPONENTE MÓVIL -->
        <MobileNav client:only="solid-js" lang={lang} />
      </div>
    </div>
  </div>
</header>
